# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Absolute origin of this app (used in emailed links and Stripe return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (test mode: keys start sk_test_) ----------------------------------
# Billing is OFF -- nothing is locked -- until both of these two are set.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...): the only Stripe key meant for the browser. Needed
# for "Add card" (Stripe's Payment Element). Safe to expose; it cannot charge.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
# Optional: the Product the price belongs to (informational; printed by
# `npm run stripe:setup`).
STRIPE_PRODUCT_ID=
# From `stripe listen` (local) or the webhook endpoint's page in the Dashboard.
STRIPE_WEBHOOK_SECRET=
